# ============================================================
# Miljøvariabler for alius-site
#
# To filer, og forskellen er ikke kosmetisk:
#
#   .env         Indlæses af BÅDE Next.js og Prisma CLI.
#                DATABASE_URL må ikke stå her.
#
#   .env.local   Indlæses af Next.js, men IKKE af Prisma CLI.
#                DATABASE_URL hører hjemme her.
#
# Grunden: Prisma CLI indlæser .env automatisk. Står produktions-
# strengen der, peger `prisma migrate dev` og `prisma migrate reset`
# på produktion uden at nogen har bedt om det. Den 27. juli 2026
# ville `prisma migrate dev` have nulstillet produktionsdatabasen
# med 74.604 observationer i. Den blev stoppet af en advarsel, ikke
# af en spærring.
#
# Se CLAUDE.md, afsnittet om databasen.
# ============================================================

# ---- Hører til i .env.local ----
DATABASE_URL="postgresql://bruger:kode@vaert/db?sslmode=require"

# ---- Kan stå i .env ----
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@alius.dk"

# Almindelig postkasse: kvitteringer og korrespondance
EMAIL_TO="hej@alius.dk"

# Driftsalarmer: stale-tjek og fejlmails fra Pulse.
# Adskilt fra EMAIL_TO, så drift kan dirigeres et andet sted hen
# uden at røre koden. Default er drift@alius.dk.
PULSE_ALERT_EMAIL_TO="drift@alius.dk"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID="G-..."

# Beskytter /api/admin/* og tillader manuelt kald af cron-endpoints
ADMIN_SECRET="..."

# Sættes af Vercel til cron-kald. Kun i produktionsmiljøet.
# CRON_SECRET="..."

# Valgfri. DST's API virker uden nøgle, men med højere rate limits med.
# DST_API_KEY="..."
