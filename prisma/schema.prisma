// ============================================================
// Alius database schema
// Used by tankeprofil and future tools
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PROFILE
// A single person's tankeprofil result.
// Can be anonymous initially, claimed via email later.
// Same person can be in multiple teams without retaking the test.
// ============================================================

model Profile {
  id          String   @id @default(cuid())

  // Identity (optional at first, can be added later)
  email       String?  @unique
  displayName String?

  // Result
  totals      Json     // { A: 8, B: 12, C: 3, D: 1 }
  primary     String   // "A" | "B" | "C" | "D"
  secondary   String
  weakest     String

  // Raw selections, so we can recalculate if the formula changes
  selections  Json     // Selections array from the test

  // Returnable link without login
  accessToken String   @unique @default(cuid())

  // Tracking
  source      String?  // "individual" | "team_invitation" | "workshop"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  teamMemberships TeamMember[]

  @@index([email])
  @@index([accessToken])
}

// ============================================================
// TEAM SESSION
// A group of people taking the test together.
// Three tokens give role-based access without user accounts.
// ============================================================

model TeamSession {
  id           String   @id @default(cuid())

  // Identification
  name         String
  companyName  String?
  ownerEmail   String
  ownerName    String?

  // Status
  status       TeamSessionStatus @default(OPEN)

  // Access via long random tokens in URL
  // join = invitees can submit but not see report or admin
  // report = anyone can view report but not modify
  // admin = owner can manage session
  joinToken    String   @unique @default(cuid())
  reportToken  String   @unique @default(cuid())
  adminToken   String   @unique @default(cuid())

  // Expected number of participants (from request)
  expectedSize Int?

  // Tracking
  createdAt    DateTime  @default(now())
  closedAt     DateTime?

  // Relations
  members      TeamMember[]
  request      TeamRequest?

  @@index([joinToken])
  @@index([reportToken])
  @@index([adminToken])
  @@index([ownerEmail])
}

enum TeamSessionStatus {
  OPEN
  CLOSED
  ARCHIVED
}

// ============================================================
// TEAM MEMBER
// Join table between Profile and TeamSession.
// Allows a profile to participate in multiple teams.
// ============================================================

model TeamMember {
  id          String   @id @default(cuid())
  sessionId   String
  profileId   String

  // Display name shown in this session's report
  // (might differ between sessions, e.g. "Mette" vs "Marketing-Mette")
  displayName String

  joinedAt    DateTime  @default(now())
  submittedAt DateTime?

  session     TeamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, profileId])
  @@index([sessionId])
  @@index([profileId])
}

// ============================================================
// TEAM REQUEST
// Lead magnet form submission.
// Owner reviews and approves manually, creating a session.
// ============================================================

model TeamRequest {
  id        String   @id @default(cuid())

  // Form content
  name      String
  email     String
  company   String
  teamSize  String
  context   String?

  // Status
  status    TeamRequestStatus @default(NEW)

  // If approved, a session is created
  sessionId String?      @unique
  session   TeamSession? @relation(fields: [sessionId], references: [id])

  // Internal notes for owner
  notes     String?

  // Tracking
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status])
  @@index([email])
}

enum TeamRequestStatus {
  NEW
  APPROVED
  DECLINED
  COMPLETED
}

// ============================================================
// PULSE — Statistical data from public APIs (DST etc.)
// ============================================================

model DataSource {
  id    String @id @default(cuid())

  slug            String  @unique  // e.g. "dst-aus08"
  name            String
  description     String?
  provider        String           // "dst"
  tableId         String           // DST table id, e.g. "AUS08"
  unit            String?          // "pct", "1000 persons", etc.
  sourceUrl       String?
  license         String?
  updateFrequency String?

  lastUpdatedAtSource DateTime?
  lastFetchedAt       DateTime?

  meta        Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataPoints  DataPoint[]
  signals     Signal[]
  fetchLogs   FetchLog[]

  @@index([slug])
  @@index([provider, tableId])
}

model DataPoint {
  id         String @id @default(cuid())
  sourceId   String

  period     String    // "2026M03", "2026K1", "2026"
  periodDate DateTime  // first day of the period (UTC)
  periodType PeriodType

  areaCode   String?
  areaType   AreaType @default(NATIONAL)
  areaName   String?

  value      Float?
  status     String?  // "provisional", "missing", DST status codes

  dimensions Json?    // extra dimensions beyond time + area

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, period, areaCode])
  @@index([sourceId, periodDate])
  @@index([sourceId, areaCode, periodDate])
}

enum PeriodType {
  MONTH
  QUARTER
  YEAR
  WEEK
}

enum AreaType {
  NATIONAL
  REGION
  LANDSDEL
  KOMMUNE
  OTHER
}

model Signal {
  id         String @id @default(cuid())
  sourceId   String

  type        String   // "TOP_MOVER", "RECORD", "STREAK", "COMPARISON", "TURNING_POINT", "OUTLIER"
  direction   String?  // "UP", "DOWN", "STABLE"
  severity    String   @default("info")  // "info", "note", "important"

  headline    String
  body        String?

  period      String?
  magnitude   Float?
  areaCode    String?
  areaName    String?
  evidence    Json?

  createdAt   DateTime @default(now())

  source      DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, type])
  @@index([sourceId, period])
}

model FetchLog {
  id         String @id @default(cuid())
  sourceId   String

  success      Boolean   @default(false)
  error        String?
  notes        String?

  inserted     Int @default(0)
  updated      Int @default(0)
  skipped      Int @default(0)
  rowsAffected Int @default(0)

  lastUpdatedAtSource DateTime?
  completedAt         DateTime?

  createdAt  DateTime @default(now())

  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
}

// ============================================================
// PULSE v2 — series / observations / ingest_runs
//
// Datakatalog fase 1, afsnit 2. Additivt: DataSource, DataPoint,
// Signal og FetchLog står urørt indtil den nye model er verificeret.
//
// Fire afvigelser fra datakataloget, alle bevidste:
//
//   1. observations har area_code. Geografi er en dimension ved
//      observationen, ikke en del af seriens identitet. Uden den ville
//      de fire geografiske dashboards kræve ~1.100 serier.
//   2. area_code er NOT NULL med "DK" som national værdi. Den gamle
//      models unique-nøgle bandt ikke, fordi Postgres regner NULL som
//      forskellig fra NULL. Det gentages ikke.
//   3. status på ingest_runs har en fjerde værdi, ABORTED, ud over
//      datakatalogets ok/no_new_data/error. Den findes, fordi det var
//      præcis den tilstand BYGV33 stod i den 25. juli: startet, aldrig
//      afsluttet, ingen fejlbesked.
//   4. Indekset på observations er et almindeligt sammensat indeks,
//      ikke datakatalogets partielle "where is_current". Prisma kan
//      ikke udtrykke partielle indeks, og et manuelt ville give
//      permanent schema-drift.
// ============================================================

enum SeriesFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RevisionPolicy {
  NONE
  MINOR
  MAJOR
}

/// Lagene svarer på ét spørgsmål: hvad ville en direktør gøre anderledes,
/// hvis tallet ændrede sig.
///
///   LEADING, COST, CAPITAL, EXTERNAL  -> handl nu
///   REALISED                          -> nedskriv det
///   STRUCTURAL                        -> ingenting i dette kvartal
///
/// REALISED og STRUCTURAL er adskilt med vilje. En konkursstigning hører
/// hjemme på ranglisten. Et befolkningstal gør ikke. STRUCTURAL udelukkes
/// fra rangordning som udgangspunkt, ellers fylder bestandstal pladser på
/// forsiden med noget ingen handler på.
enum SeriesLayer {
  LEADING     // konjunktur, forventning, byggetilladelser
  COST        // priser, løn, energi
  CAPITAL     // renter, valuta
  EXTERNAL    // udenlandske indikatorer
  REALISED    // det der allerede er sket: konkurser, ledighed, omsætning
  STRUCTURAL  // bestandstal: befolkning, indkomst, demografi, ejendomsværdi
}

/// Aktiv eller lukket, som felt frem for i meta, så en forespørgsel kan
/// filtrere uden at grave i JSON. En lukket serie bevares i fuld længde
/// og vises gerne, men må aldrig kunne ende på ranglisten.
enum SeriesStatus {
  ACTIVE
  CLOSED
}

enum IngestStatus {
  OK
  NO_NEW_DATA
  ERROR
  ABORTED
}

model Series {
  id     String @id // fx "dst.konjunktur.sammensat"

  nameDa    String @map("name_da")
  source    String // "DST" | "EDS" | "NBDK" | "EUROSTAT"
  sourceRef String @map("source_ref") // tabel-ID eller datasæt-navn
  unit      String // "pct" | "antal" | "indeks_2015" | "nettotal" | "dkk"

  frequency       SeriesFrequency
  expectedLagDays Int             @map("expected_lag_days")
  revisionPolicy  RevisionPolicy  @map("revision_policy")
  attribution     String
  layer           SeriesLayer
  status          SeriesStatus    @default(ACTIVE)

  /// Må serien konkurrere om en plads på ranglisten.
  ///
  /// Selvstændigt felt, ikke afledt af lag. STRUCTURAL og CLOSED sætter
  /// det automatisk til false, men det kan sættes manuelt for enkelte
  /// serier uden at flytte dem til et andet lag.
  ///
  /// EU27 er tilfældet der begrunder designet: den er referencelinje for
  /// tysk erhvervstillid og skal ikke konkurrere med det den forklarer.
  /// Men kollapser europæisk erhvervstillid selv, er det den vigtigste
  /// besked på siden. Et lag ville låse den ude permanent. Et flag kan
  /// omgøres.
  ///
  /// Rangeringen læser kun dette felt. Den udleder aldrig selv.
  rankable       Boolean @default(true)
  /// Hvorfor rankable er false. Tom når serien er rangerbar.
  rankableReason String? @map("rankable_reason")

  /// Gruppe af serier der bevæger sig sammen, enten af konstruktion
  /// eller af natur. Højst én serie i en gruppe må være rankable.
  ///
  /// Kildekvoten i byggebriefens afsnit 4 fanger korrelation INDEN FOR
  /// en kilde. Dette felt fanger den PÅ TVÆRS af kilder, hvor kvoten
  /// ikke ser den: nominelt detailindeks fra DETA211A mod deflateret
  /// mængdeindeks fra DERIVED er samme kendsgerning fra to kilder.
  ///
  /// Null betyder at serien ikke er korreleret med nogen anden.
  rankGroup String? @map("rank_group")

  /// Brud i serien: en dato hvor definitionen ændrede sig, så tal før og
  /// efter ikke måler det samme. Ikke en ændring i virkeligheden.
  ///
  /// Z-score og alle afledte beregninger må ikke krydse den. Serien vises
  /// i fuld længde, men mønstre beregnes kun på perioden fra og med
  /// break_at. Uden reglen læser ranglisten en klassifikationsændring som
  /// en usædvanlig bevægelse og sætter et falsk signal øverst.
  ///
  /// Brug analysisStart() i src/lib/pulse-series.ts frem for at læse
  /// feltet direkte, så reglen kun findes ét sted.
  breakAt     DateTime? @map("break_at") @db.Date
  breakReason String?   @map("break_reason")

  // Sporbarhed tilbage til den gamle model, så migrationen kan
  // verificeres og rulles tilbage uden gætteri.
  legacySourceSlug String? @map("legacy_source_slug")
  legacyAreaCode   String? @map("legacy_area_code")
  meta             Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  observations Observation[]
  ingestRuns   IngestRun[]

  @@index([source])
  @@index([layer, status])
  @@index([status])
  @@index([rankable, layer])
  @@index([rankGroup])
  @@index([legacySourceSlug])
  @@map("series")
}

model Observation {
  seriesId String @map("series_id")

  // Udelukkende geografi. "DK" for nationale serier. Alt andet, som
  // branche eller spørgsmålsnummer, indgår i serie-identiteten.
  areaCode String @default("DK") @map("area_code")

  period DateTime @db.Date // normaliseret til første dag i perioden

  // null betyder "ikke publiceret endnu", ikke nul.
  value Decimal? @db.Decimal(20, 6)

  retrievedAt DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(3)
  isCurrent   Boolean  @default(true) @map("is_current")

  series Series @relation(fields: [seriesId], references: [id])

  // retrieved_at er en del af nøglen. Det er dét, der gør tabellen
  // append-only: en ny hentning kan aldrig kollidere med en gammel.
  @@id([seriesId, areaCode, period, retrievedAt])
  @@index([seriesId, areaCode, period, isCurrent])
  @@index([seriesId, isCurrent, period])
  @@map("observations")
}

model IngestRun {
  id BigInt @id @default(autoincrement())

  // Nullable, fordi de migrerede FetchLog-rækker beskriver en kørsel
  // på kilde-niveau, før serier fandtes. At fordele dem ud på hver
  // serie ville opfinde kørsler der aldrig har fundet sted.
  seriesId   String? @map("series_id")
  sourceSlug String? @map("source_slug")

  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  status       IngestStatus
  rowsWritten  Int?    @map("rows_written")
  rowsRevised  Int?    @map("rows_revised")
  errorMessage String? @map("error_message")

  series Series? @relation(fields: [seriesId], references: [id])

  @@index([seriesId, startedAt])
  @@index([sourceSlug, startedAt])
  @@index([status, startedAt])
  @@map("ingest_runs")
}
